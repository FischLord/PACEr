# TurnierManager Environment Variables
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production

# Database (SQLite by default, can use PostgreSQL)
# DATABASE_URL=sqlite:///turnier_manager.db
# DATABASE_URL=postgresql://user:password@localhost/turnier_manager

# Server
HOST=0.0.0.0
PORT=5000

# Admin Password Hash
# Generate with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your_password'))"
# Or visit /auth/generate-hash?password=your_password in debug mode
ADMIN_PASSWORD_HASH='scrypt:32768:8:1$...'
